{
  "name": "skeci-ui",
  "version": "1.3.1",
  "description": "Give your web apps a unique 'sketched on a whiteboard' feel with Skeci UI—a React component library built with Rough.js.",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "bin": {
    "skeci-ui": "dist/index.js"
  },
  "scripts": {
    "build": "tsup && npm run copy",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "copy": "cpx \"src/templates/**/*\" dist/templates"
  },
  "keywords": [],
  "author": "cakjengger@gmail.com",
  "license": "MIT",
  "packageManager": "pnpm@10.29.2",
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "chalk": "^5.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "fs-extra": "^11.3.4",
    "lucide-react": "^1.8.0",
    "prompts": "^2.4.2",
    "react": "^19.2.5",
    "react-datepicker": "^9.1.0",
    "react-dom": "^19.2.5",
    "roughjs": "^4.6.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/fs-extra": "^11.0.4",
    "@types/prompts": "^2.4.9",
    "@types/react": "^19.2.14",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "cpx": "^1.5.0",
    "debug": "^4.4.3",
    "eslint": "^10.2.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.2",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.2",
    "vitest": "^4.1.5"
  },
  "patchedDependencies": {
    "tsup@8.5.1": "patches/tsup@8.5.1.patch"
  }
}
